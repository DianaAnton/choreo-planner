# Firebase web config — public by design (it ships in the client bundle).
# Firestore security rules are what actually protect data, not these values.
# Copy to .env.local and fill in from the Firebase console: docs/firebase-setup.md step 3.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Point the app at the local emulator suite instead of the cloud.
VITE_USE_EMULATORS=false

# Where that suite is listening. Leave unset on the laptop. To click through on
# a phone, set it to the laptop's LAN address — over the network 127.0.0.1 means
# the phone itself, and Auth and Firestore fail silently.
#   VITE_USE_EMULATORS=true VITE_EMULATOR_HOST=192.168.x.x pnpm dev --host
# VITE_EMULATOR_HOST=127.0.0.1
