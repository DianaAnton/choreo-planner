# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored.

# From docs/firebase-setup.md step 1 — the ID, not the display name.
project_id = "choreo-planner"

# PERMANENT. Cannot be changed after the database exists.
# eur3 = Europe multi-region, nam5 = North America multi-region.
firestore_location = "eur3"

# owner/repo — pins Workload Identity Federation to this repository only.
github_repository = "DianaAnton/choreo-planner"

# A persistent staging URL. Requires Blaze; PR preview channels work without it.
enable_staging_site = false

# Defaults to "<project_id>-tfstate"; set only if you named the bucket differently.
# state_bucket = "choreo-planner-tfstate"
